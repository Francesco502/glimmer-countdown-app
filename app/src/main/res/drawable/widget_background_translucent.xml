<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="?attr/widgetBackgroundRadius" />
            <solid android:color="#DDF2F3F0" />
            <stroke
                android:width="@dimen/widget_stroke_width"
                android:color="#24202124" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="?attr/widgetBackgroundRadius" />
            <gradient
                android:angle="270"
                android:endColor="#0AFFFFFF"
                android:startColor="#2BFFFFFF" />
        </shape>
    </item>
</layer-list>
