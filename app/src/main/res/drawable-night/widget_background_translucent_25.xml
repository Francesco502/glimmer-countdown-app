<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="?attr/widgetBackgroundRadius" />
            <solid android:color="#A61C1C1E" />
            <stroke
                android:width="@dimen/widget_stroke_width"
                android:color="#26FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="?attr/widgetBackgroundRadius" />
            <gradient
                android:angle="270"
                android:endColor="#05FFFFFF"
                android:startColor="#1AFFFFFF" />
        </shape>
    </item>
</layer-list>
