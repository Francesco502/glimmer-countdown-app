<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Android 12+ (API 31+) 的系统启动页会自动将图标放入圆形容器。
      将圆圈背景色和全屏底色都设为暖白，让启动体验保持克制。
    -->
    <style name="Theme.TimeAPK" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/splash_bg</item>
    </style>

    <style name="Theme.TimeAPK.Widget" parent="android:Theme.DeviceDefault.DayNight">
        <item name="widgetBackgroundRadius">@dimen/widget_background_radius</item>
        <item name="widgetItemRadius">@dimen/widget_item_radius</item>
        <item name="widgetSurfaceColor">@color/widget_surface_color</item>
        <item name="widgetSurfaceHighlightColor">@color/widget_surface_highlight_color</item>
        <item name="widgetSurfaceHighlightFadeColor">@color/widget_surface_highlight_fade_color</item>
        <item name="widgetStrokeColor">@color/widget_stroke_color</item>
        <item name="widgetItemSurfaceColor">@color/widget_item_surface_color</item>
        <item name="widgetItemHighlightColor">@color/widget_item_highlight_color</item>
        <item name="widgetItemHighlightFadeColor">@color/widget_item_highlight_fade_color</item>
        <item name="widgetItemStrokeColor">@color/widget_item_stroke_color</item>
        <item name="widgetTextPrimaryColor">@color/widget_text_primary_color</item>
        <item name="widgetTextSecondaryColor">@color/widget_text_secondary_color</item>
        <item name="widgetTextAccentColor">@color/widget_text_accent_color</item>
    </style>
</resources>
