<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Android 12+ (API 31+) 的系统启动画面会自动将图标放入圆形容器。
      将圆圈背景色和全屏底色都设为 #141622（深海蓝黑），使白色圆圈「隐形」。
    -->
    <style name="Theme.TimeAPK" parent="android:Theme.Material.Light.NoActionBar">
        <!-- pre-12 仍用 windowBackground 兜底 -->
        <item name="android:windowBackground">@drawable/splash_background</item>

        <!-- Android 12+ 系统 Splash Screen 属性 -->
        <!-- 全屏背景色：深海蓝黑 -->
        <item name="android:windowSplashScreenBackground">@color/splash_bg</item>
        <!-- 圆形区域内的图标 -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher</item>
        <!-- 圆形区域的底色：与全屏背景一致，让圆圈不可见 -->
        <item name="android:windowSplashScreenIconBackgroundColor">@color/splash_bg</item>
    </style>
</resources>
